# Límites para subida de archivos Excel (Semrush exports)
<IfModule mod_php.c>
  php_flag  file_uploads      on
  php_value upload_max_filesize 32M
  php_value post_max_size       33M
  php_value memory_limit        128M
</IfModule>
<IfModule mod_php8.c>
  php_flag  file_uploads      on
  php_value upload_max_filesize 32M
  php_value post_max_size       33M
  php_value memory_limit        128M
</IfModule>
<IfModule mod_php7.c>
  php_flag  file_uploads      on
  php_value upload_max_filesize 32M
  php_value post_max_size       33M
  php_value memory_limit        128M
</IfModule>

Options -Indexes

RewriteEngine On

# Forzar HTTPS en producción
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Forzar www a sin www
RewriteCond %{HTTP_HOST} ^www\.caroltemp\.com [NC]
RewriteRule ^(.*)$ https://caroltemp.com/$1 [L,R=301]

# Redirigir .php a sin .php (excepto APIs admin que reciben file uploads)
RewriteCond %{REQUEST_URI} !auditor-estrategico-api\.php [NC]
RewriteCond %{REQUEST_URI} !agente-paginas-api\.php [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Si entran a /zonas/ redirigir a zonas.php
RewriteRule ^zonas/?$ zonas.php [L]

# Servicios por ciudad — index
RewriteRule ^fontanero/?$ fontanero/index.php [L]
RewriteRule ^fugas/?$ fugas/index.php [L]
RewriteRule ^desatascos/?$ desatascos/index.php [L]
RewriteRule ^blog/?$ blog/index.php [L]
RewriteRule ^proyectos/?$ proyectos/index.php [L]

# URLs amigables blog
RewriteRule ^blog/categoria/([^/]+)/?$ blog/index.php?categoria=$1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog/([^/]+)/?$ blog/articulo.php?slug=$1 [QSA,L]

# URLs amigables proyectos
RewriteRule ^proyectos/servicio/([^/]+)/?$ proyectos/index.php?servicio=$1 [QSA,L]
RewriteRule ^proyectos/zona/([^/]+)/?$ proyectos/index.php?zona=$1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^proyectos/([^/]+)/?$ proyectos/proyecto.php?slug=$1 [QSA,L]

# Quitar .php de las URLs (general — va al final)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Página 404
ErrorDocument 404 /404.php

# Seguridad
<FilesMatch "\.(sql|log|env|git|htpasswd)$">
  Require all denied
</FilesMatch>

# Proteger includes
<FilesMatch "^(db|head|nav|footer|admin_sidebar|admin_style)\.php$">
  Require all denied
</FilesMatch>

# Caché navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>